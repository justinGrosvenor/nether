# Generated by scripts/build-swerver-guest.sh. The supervisor reads this file
# from its current working directory.
control_socket = /tmp/nsw/control.sock
socket_dir = /tmp/nsw
work_root = /tmp/nsw/vms
kernels_dir = @KERNELS_DIR@
nether_bin = @NETHER_BIN@
base_snap = /tmp/nsw/vms/00000000/base.snap
launcher_mode = real
app_port = 8080
guest_service_prestarted = true
cpus = 1
ram_mb = 512
max_vms = 32
idle_ttl_ms = 3600000
idle_timeout_s = 3600
boot_budget_ms = 30000
status_addr = 127.0.0.1:19190
status_service_key = dev-status-key
